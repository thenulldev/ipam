# IPAM environment file — installed by scripts/install-systemd.sh as
# /etc/ipam/ipam.env (root:root 0640). Override any line below to change
# the runtime behaviour without touching the systemd unit.
#
# After editing, run `sudo systemctl restart ipam`.

# --- Server ----------------------------------------------------------------
# Port the Hono server listens on. Default: 8787.
PORT=8787

# Persistent state lives under /var/lib/ipam. SQLite db, uploaded blobs,
# and backups all sit under this tree.
IPAM_DATA_DIR=/var/lib/ipam
IPAM_DB=/var/lib/ipam/ipam.db
IPAM_UPLOAD_DIR=/var/lib/ipam/uploads

# Vite build output the compiled server serves as the SPA.
# /opt/ipam is the install root — adjust if you install elsewhere.
IPAM_DIST_DIR=/opt/ipam/dist

# --- Bind / listen ---------------------------------------------------------
# Hono's node-server binds to ::1 by default; flip to 0.0.0.0 if you want
# the service reachable on every interface (e.g. behind a reverse proxy on
# a separate host). Leave commented for localhost-only.
# HOST=0.0.0.0

# --- Sessions --------------------------------------------------------------
# REQUIRED in any non-dev deployment. 32+ chars of randomness. The install
# script will refuse to start the service until this is set.
IPAM_SESSION_SECRET=replace-me-with-32-or-more-chars

# --- Logging ---------------------------------------------------------------
# Optional. Forwarded to journald via SyslogIdentifier=ipam; nothing to set
# here unless you want to crank verbosity on the Hono internals.
# LOG_LEVEL=info